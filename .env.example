# NeuroScope 3D Environment Configuration

# Optional: Path to custom trained checkpoint (defaults to bundled brats_mri_segmentation weights if omitted)
# NEUROSCOPE_MODEL_WEIGHTS=backend/app/models/brats_mri_segmentation/brats_mri_segmentation/models/model.pt

# Server Port (default: 8001; 8000 may conflict on Windows with other services)
NEUROSCOPE_PORT=8001
PORT=8001

# CORS Allowed Origins (comma-separated)
NEUROSCOPE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8001,http://127.0.0.1:8001

# Maximum Upload File Size in Bytes (default: 1 GB)
# MAX_FILE_SIZE_BYTES=1073741824
